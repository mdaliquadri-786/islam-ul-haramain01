# ==============================================================================
# ISLAM UL HARAMAIN — STAGING ENVIRONMENT TEMPLATE
# ZERO REAL SECRETS COMMITTED — PLACEHOLDERS ONLY
#
# Target Staging Supabase Project Ref: mlxyegiwdzmcybvhtgwy
# Copy this template to .env.staging or .env.staging.local for staging testing.
# Never commit real credentials or secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CREDENTIALS (Exposed to browser bundles)
# ------------------------------------------------------------------------------
# Staging Supabase Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://mlxyegiwdzmcybvhtgwy.supabase.co

# Staging Supabase Publishable / Anon API Key:
# Supports either legacy anon JWT or new sb_publishable_... key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=<STAGING_SUPABASE_PUBLISHABLE_OR_ANON_KEY>

# Optional modern alias (supported by @islamic/database fallback):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<STAGING_SUPABASE_PUBLISHABLE_KEY>

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (NEVER expose to client code or prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Staging Supabase Service Role / Secret API Key:
# Used only by backend server actions or administrative background jobs.
# Supports either legacy service_role JWT or new sb_secret_... key:
SUPABASE_SERVICE_ROLE_KEY=<STAGING_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY>

# ------------------------------------------------------------------------------
# 3. APPLICATION ADMINISTRATIVE ACCESS SECRET
# ------------------------------------------------------------------------------
# High-entropy random secret for internal /api/admin/* route authorization.
# Strictly distinct and independent from Supabase database/API keys.
# Generate locally using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_SECRET=<GENERATE_SEPARATELY_HIGH_ENTROPY_RANDOM_SECRET>
