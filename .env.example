# ==============================================================================
# ENVIRONMENT TEMPLATE — ZERO REAL SECRETS COMMITTED
# Copy this file to .env.local for local development.
# Real credentials must NEVER be committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CREDENTIALS (Safe to expose to browser bundles)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER expose to browser code or prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
