# ==============================================================================
# ISLAM UL HARAMAIN — PRODUCTION ENVIRONMENT TEMPLATE
# ZERO REAL SECRETS COMMITTED — PLACEHOLDERS ONLY
#
# Target: PRODUCTION SUPABASE & PRODUCTION VERCEL HOSTING
# NEVER use staging project credentials (mlxyegiwdzmcybvhtgwy) here.
# Production must use a separate Supabase project.
# Copy to .env.production.local for local production testing.
# Never commit real credentials or secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CREDENTIALS (Exposed to browser / mobile bundles)
# ------------------------------------------------------------------------------
# Production Supabase Project URL (e.g. https://<prod-ref>.supabase.co):
NEXT_PUBLIC_SUPABASE_URL=<PRODUCTION_SUPABASE_PROJECT_URL>

# Production Supabase Publishable / Anon API Key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=<PRODUCTION_SUPABASE_PUBLISHABLE_OR_ANON_KEY>

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (NEVER expose to client code or prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Production Supabase Service Role / Secret API Key:
# Used only by backend server actions or administrative background jobs.
SUPABASE_SERVICE_ROLE_KEY=<PRODUCTION_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY>

# ------------------------------------------------------------------------------
# 3. APPLICATION ADMINISTRATIVE ACCESS SECRET
# ------------------------------------------------------------------------------
# High-entropy random 32-byte secret for internal /api/admin/* route authorization.
# Strictly distinct and independent from Supabase database/API keys and staging secret.
# Generate locally using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_SECRET=<GENERATE_HIGH_ENTROPY_32_BYTE_RANDOM_SECRET>
